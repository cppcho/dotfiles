#!/usr/bin/env bash
# herdr-move-pane-to-worktree — send the active pane to another worktree's
# workspace (tmux move-pane across sessions). Bound to prefix+m with
# type = "popup": fzf needs a tty, and a popup is the only command type whose
# HERDR_ACTIVE_PANE_ID is the tiled pane under it rather than the command's
# own temporary pane.
#
# The picker mirrors herdr-sessionizer (prefix+f): same row shape, `●` on
# worktrees that already have a live space, most recently opened first.
set -euo pipefail

pane="${HERDR_ACTIVE_PANE_ID:?not run from a herdr keybinding}"
ws="${HERDR_ACTIVE_WORKSPACE_ID:?not run from a herdr keybinding}"

# This pane closes the moment the script exits, so hold any message.
hold() { echo "$1"; sleep 1.2; exit 0; }

# Worktrees come from the moved pane's own repo, not this picker pane's cwd.
cwd=$(herdr pane list --workspace "$ws" \
  | jq -r --arg p "$pane" '.result.panes[] | select(.pane_id == $p) | .cwd')
[[ -d "$cwd" ]] || hold "cannot resolve cwd of $pane"
here=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || hold "not inside a git repository"
main=$(git -C "$cwd" worktree list --porcelain | head -1 | sed 's/^worktree //')

# Same row format as `gwt switch`, minus the worktree the pane already sits in
# and Claude Code's own .claude/worktrees checkouts, which prefix+f also hides.
rows=$(
  git -C "$cwd" worktree list --porcelain | awk -v main="$main" -v here="$here" '
    /^worktree / { wt = substr($0, 10) }
    /^branch /   {
      if (wt == here || wt ~ /\/\.claude\/worktrees\//) next
      b = substr($0, 8); sub(/^refs\/heads\//, "", b)
      n = split(wt, parts, "/"); dir = parts[n]
      if (length(dir) > 28) dir = substr(dir, 1, 26) ".."
      printf "%s\t%s%s\t%s\n", dir, b, (wt == main ? " (main)" : ""), wt
    }'
)
[[ -n "$rows" ]] || hold "no other worktree in ${main##*/}"

# Open workspaces, by checkout path and by label, so a row can say whether the
# pick joins a live space or opens one. Spaces opened before herdr indexed their
# worktree only carry a label.
declare -A path_ws lbl_ws
while IFS=$'\t' read -r id label cpath; do
  [[ -n $cpath ]] && path_ws[$cpath]=$id
  [[ -n $label ]] && lbl_ws[$label]=$id
done < <(herdr workspace list 2>/dev/null | jq -r '(.result.workspaces // [])[]
    | "\(.workspace_id)\t\(.label)\t\(.worktree.checkout_path // "")"')

declare -A recent
while IFS=$'\t' read -r ts rp; do recent[$rp]=$ts; done < <("$HOME/bin/herdr-recent" list)

listing=$(
  while IFS=$'\t' read -r dir branch wt; do
    mark=" "; [[ -n ${path_ws[$wt]:-} || -n ${lbl_ws[${wt##*/}]:-} ]] && mark="●"
    printf '%s\t%s %s\t%s\n' "${recent[$wt]:-0}" "$mark" "$(printf '%-28s %s' "$dir" "$branch")" "$wt"
  done <<<"$rows" | sort -t$'\t' -k1,1rn -k2,2 | cut -f2-
)

pick=$(printf '%s\n' "$listing" \
  | fzf --exact --no-sort --delimiter=$'\t' --with-nth=1 \
        --preview 'echo {2}' --preview-window=down,1 --prompt='Move pane to > ') || exit 0
[[ -z $pick ]] && exit 0
wt=${pick#*$'\t'}

# A fresh space comes with an empty root shell, closed once the pane has landed.
resolved=$("$HOME/bin/herdr-workspace-for" "$wt") || hold "cannot open a space for $wt"
IFS=$'\t' read -r wsid root <<<"$resolved"
[[ -n "$wsid" ]] || hold "cannot open a space for $wt"

herdr pane move "$pane" --workspace "$wsid" --new-tab --focus >/dev/null
[[ -n "${root:-}" ]] && herdr pane close "$root" >/dev/null
exit 0
