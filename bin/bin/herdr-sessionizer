#!/usr/bin/env bash
# herdr-sessionizer — a tmux-sessionizer for herdr spaces.
#
# fzf over project roots ($TMUX_SESSIONIZER_PATHS) and every gwt worktree under
# ~/.worktrees in one list; focus the herdr space already open for the pick,
# otherwise create one. Ordered by when each was last opened here (see
# ~/bin/herdr-recent), then ~/.z frecency for never-opened entries.
#
# Worktrees are read off the filesystem (the `.git` pointer file and its HEAD)
# rather than `git worktree list` per repo, which takes about a second across
# ~/dev. Claude Code's .claude/worktrees checkouts are left out on purpose.
#
# Bind via a herdr [[keys.command]] with type = "pane" so fzf runs in a
# temporary interactive pane:
#   [[keys.command]]
#   key = "prefix+f"
#   type = "pane"
#   command = "~/bin/herdr-sessionizer"
#
# With a directory argument it skips the picker (mirrors `af <dir>`):
#   herdr-sessionizer ~/dev/foo
# With --list it prints the ordered rows and exits (for debugging).
set -euo pipefail

# Surface a fatal error in the throwaway herdr pane, then pause so it stays
# readable before the pane closes.
die() {
    printf '\n\033[1;31mherdr-sessionizer: %s\033[0m\n' "$1" >&2
    printf 'Press Enter to close… ' >&2
    read -r _ || true
    exit 1
}

# Run a herdr socket command; on transport failure or a JSON {"error":...}
# response (e.g. a client/server protocol mismatch after a herdr upgrade),
# surface it and pause instead of silently doing nothing. Result left in
# $HERDR_OUT. Must be called from the main shell so die() can exit the script.
HERDR_OUT=""
herdr_call() {
    if ! HERDR_OUT=$(herdr "$@" 2>&1); then
        die "'herdr $*' failed:"$'\n'"$HERDR_OUT"
    fi
    if printf '%s' "$HERDR_OUT" | jq -e 'has("error")' >/dev/null 2>&1; then
        die "'herdr $*':"$'\n'"$(printf '%s' "$HERDR_OUT" | jq -r '.error.message // .error')"
    fi
}

# Open workspaces, by checkout path and by label, for the `●` marker on rows
# whose pick joins a live space instead of opening one. Spaces opened before
# herdr indexed their worktree only carry a label.
declare -A path_ws lbl_ws
herdr_call workspace list
while IFS=$'\t' read -r wsid label cpath; do
    [[ -n $cpath ]] && path_ws[$cpath]=$wsid
    [[ -n $label ]] && lbl_ws[$label]=$wsid
done < <(printf '%s' "$HERDR_OUT" | jq -r '(.result.workspaces // [])[]
    | "\(.workspace_id)\t\(.label)\t\(.worktree.checkout_path // "")"')

# Focus the space for a directory, opening one if it has none.
open_dir() {
    local dir="$1"
    dir="${dir/#\~/$HOME}"; dir="${dir%/}"
    [[ -d $dir ]] || die "no such directory: $dir"
    "$HOME/bin/herdr-workspace-for" --focus "$dir" >/dev/null \
        || die "could not open a space for $dir"
}

# Direct argument skips the picker.
if [[ $# -eq 1 && $1 != --list ]]; then
    open_dir "$1"
    exit 0
fi

# --- candidates ----------------------------------------------------------------
# rows: "<display>\t<path>"
rows=()

# Row display: "<repo> <worktree dir> (<branch>)". A main checkout has no
# directory of its own to name — it *is* the repo — so it shows "*<branch>"
# instead, and a worktree directory named after its branch shows just the one
# name. Result in $ROW; no subshell, because this runs for every candidate on
# every keypress.
ROW=""
fmt_row() {
    local rest
    if [[ -z $2 ]]; then                rest="${3:+*$3}"
    elif [[ -z $3 || $3 == "$2" ]]; then rest="$2"
    else                                 rest="$2 ($3)"
    fi
    if [[ -n $rest ]]; then printf -v ROW '%-24s %s' "$1" "$rest"; else ROW="$1"; fi
}

# Describe a checkout from its git dir alone — .git is a directory in a clone
# and a pointer file in a linked worktree. Result in $REPO (the owning repo),
# $DIR (the checkout's own directory name, empty when it *is* the repo) and
# $BRANCH (empty on a detached HEAD). Non-zero for a path that is no checkout,
# or whose .git points somewhere else entirely, such as a submodule.
REPO="" DIR="" BRANCH=""
resolve_checkout() {
    local gitdir="$1/.git" head=""
    if [[ -f $gitdir ]]; then
        read -r _ gitdir 2>/dev/null < "$1/.git" || return 1
    fi
    if [[ $gitdir == */.git/worktrees/* ]]; then
        REPO="${gitdir%/.git/worktrees/*}"; REPO="${REPO##*/}"; DIR="${1##*/}"
    elif [[ -d $gitdir ]]; then
        REPO="${1##*/}"; DIR=""
    else
        return 1
    fi
    BRANCH=""
    read -r _ head 2>/dev/null < "$gitdir/HEAD" || return 0
    [[ $head == refs/heads/* ]] && BRANCH="${head#refs/heads/}"
    return 0
}

# A candidate directory, git or not: a plain directory shows its own name alone.
add_repo() {
    if resolve_checkout "$1"; then
        fmt_row "$REPO" "$DIR" "$BRANCH"
    else
        fmt_row "${1##*/}" "" ""
    fi
    rows+=("$ROW"$'\t'"$1")
}

IFS=':' read -ra _paths <<<"${TMUX_SESSIONIZER_PATHS:-$HOME/dev/}"
for p in "${_paths[@]}"; do
    p="${p/#\~/$HOME}"
    if [[ $p == */ ]]; then
        while IFS= read -r d; do add_repo "$d"; done \
            < <(find -L "${p%/}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
    else
        [[ -d $p ]] && add_repo "$p"
    fi
done

# gwt worktrees: ~/.worktrees/<repo>-<slug> and the older nested <repo>/<slug>.
# A directory with its own .git is a checkout; otherwise it groups checkouts.
# Pure bash file reads: this runs for every checkout on every keypress.
add_worktree() {
    resolve_checkout "$1" || return 0
    [[ -n $DIR ]] || return 0   # a clone or a submodule, not a linked worktree
    fmt_row "$REPO" "$DIR" "$BRANCH"
    rows+=("$ROW"$'\t'"$1")
}
wt_root="${GWT_WORKTREES_DIR:-$HOME/.worktrees}"
for d in "$wt_root"/*/; do
    d="${d%/}"
    if [[ -f $d/.git ]]; then
        add_worktree "$d"
    else
        for c in "$d"/*/; do [[ -f ${c%/}/.git ]] && add_worktree "${c%/}"; done
    fi
done

# --- ordering ------------------------------------------------------------------
declare -A recent zscore
while IFS=$'\t' read -r ts rp; do recent[$rp]=$ts; done < <("$HOME/bin/herdr-recent" list)
if [[ -f ~/.z ]]; then
    while IFS='|' read -r zd zs _; do zscore[$zd]=${zs%%.*}; done < ~/.z
fi

listing=$(
    for row in "${rows[@]}"; do
        path="${row#*$'\t'}"; disp="${row%%$'\t'*}"
        mark=" "; [[ -n ${path_ws[$path]:-} || -n ${lbl_ws[${path##*/}]:-} ]] && mark="●"
        # recency epoch (seconds) outranks any z score (well below 1e9).
        printf '%s\t%s\t%s %s\t%s\n' "${recent[$path]:-0}" "${zscore[$path]:-0}" "$mark" "$disp" "$path"
    done | sort -t$'\t' -k1,1rn -k2,2rn -k3,3 | cut -f3-
)

if [[ ${1:-} == --list ]]; then
    printf '%s\n' "$listing"
    exit 0
fi

selected=$(printf '%s\n' "$listing" \
    | fzf --exact --no-sort --delimiter=$'\t' --with-nth=1 \
          --preview 'echo {2}' --preview-window=down,1 --prompt='Space > ') || exit 0
[[ -z $selected ]] && exit 0

open_dir "${selected#*$'\t'}"
