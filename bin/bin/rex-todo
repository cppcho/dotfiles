#!/usr/bin/env bash
# rex-todo — show or hide the TODO list (prefix+shift+t).
#
#   rex-todo <pane> [<session>]
#
# The list is ~/Documents/TODO.md open in nvim, in a floating pane labelled
# TODO, one per session:
# - When the TODO pane has focus, minimize it.
# - When the session has one, bring it back and focus it.
# - Otherwise open one over the current tab.
#
# The buffer saves itself on InsertLeave and TextChanged, so a note is on disk
# as soon as it is typed. The file is shared by every session, so a second copy
# open in another session shows nvim's swap warning, which is the right moment
# to notice it.
set -euo pipefail

block="${1:?usage: rex-todo <pane> [<session>]}"
sid="${2:-${REX_SESSION:?usage: rex-todo <pane> <session>}}"
file="$HOME/Documents/TODO.md"

todo=$(rex api call -s "$sid" session.list_blocks '{}' \
    | jq -r 'first(.blocks[] | select(.label == "TODO") | .block_id) // empty')

if [[ -n $todo ]]; then
    # The floating layer that holds the TODO pane.
    layer=$(rex api call -s "$sid" session.view '{}' | jq -r --arg b "$todo" '
        first(.windows[].layers[] | select(any(.layout | .. | .block_id? // empty; . == $b)) | .layer_id) // empty')
    if [[ -n $layer ]]; then
        state=normal focus=true
        if [[ $todo == "$block" ]]; then state=minimized focus=false; fi
        rex api call -s "$sid" session.set_layer_state \
            "$(jq -nc --arg l "$layer" --arg s "$state" --argjson f "$focus" '{layer_id: $l, state: $s, focus: $f}')" >/dev/null
        exit 0
    fi
fi

rex api call -s "$sid" session.new_layer "$(jq -nc --arg file "$file" --arg home "$HOME" '{
    bounds: [0.2, 0.1, 0.6, 0.8],
    focus: true,
    layout: {block: {
        flavor: "com.superlogical.terminal.shell",
        label: "TODO",
        options: {
            command: ["nvim", "+autocmd InsertLeave,TextChanged <buffer> silent write", $file],
            cwd: $home,
            interactive: true
        }
    }}
}')" >/dev/null
