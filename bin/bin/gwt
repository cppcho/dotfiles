#!/usr/bin/env bash
# Git worktree + tmux/herdr workflow helper
#
# Runs under either multiplexer: each worktree gets its own tmux session or
# herdr workspace, chosen automatically based on where gwt is invoked.
#
# Usage:
#   gwt switch [branch|#N|pr-url]  Switch to a worktree (fzf picker if no arg, create if needed)
#   gwt delete [--force]            Pick a worktree with fzf and remove it
#   gwt purge                      Remove worktrees whose branches are merged
#   gwt reclaim                    Put this worktree back on the branch it is named for
#   gwt hydrate [--force] [--no-setup] [path]
#                                  Link shared paths + run setup on a worktree (idempotent)
#   gwt hooks                      Install the post-checkout hook that hydrates
#                                  worktrees created outside gwt
#   gwt setup                      Open .gwt-setup in the repo root with $EDITOR
#   gwt links [--apply]            Open .gwt-links with $EDITOR (--apply: link here now)
#
# Shared paths:
#   New worktrees get symlinks to git-ignored paths in the main worktree, so
#   scratch space and local config follow you across trees. `.scratch` is always
#   linked; a `.gwt-links` file in the repo root adds repo-specific paths.
#
# Setup script:
#   Place a `.gwt-setup` file in your repo root (git-ignored). It runs once per
#   worktree, detached in the background, inside `direnv exec .` when the tree's
#   .envrc matches the main checkout's; output -> <worktree>/.gwt-setup.log.
#   Hydration reaches every new worktree, not just gwt's, through a git
#   post-checkout hook gwt installs the first time it runs in a repo.

set -e

# Absolute path to this script, for the detached setup worker and the git hook.
case "$0" in
    */*) GWT_SELF=$(cd "$(dirname "$0")" && pwd)/$(basename "$0") ;;
    *)   GWT_SELF=$(command -v "$0") ;;
esac

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

get_main_worktree() {
    git worktree list --porcelain | head -1 | sed 's/^worktree //'
}

get_default_branch() {
    if git show-ref --verify --quiet refs/heads/main 2>/dev/null; then
        echo "main"
    elif git show-ref --verify --quiet refs/heads/master 2>/dev/null; then
        echo "master"
    else
        echo "Error: could not find main or master branch" >&2
        exit 1
    fi
}

# Directory that holds all gwt-created worktrees. Override with $GWT_WORKTREES_DIR.
# Worktrees are nested per repo as "<repo>/<slug>", so every repo's trees live
# under one root without colliding. git worktree add creates the <repo>/ dir;
# this just ensures the root exists.
worktrees_dir() {
    local dir="${GWT_WORKTREES_DIR:-$HOME/.worktrees}"
    mkdir -p "$dir"
    echo "$dir"
}

# Find existing worktree path for a given branch name
find_worktree_for_branch() {
    local branch="$1"
    git worktree list --porcelain | awk -v branch="$branch" '
        /^worktree / { wt = substr($0, 10) }
        /^branch /   { b = substr($0, 8); sub(/^refs\/heads\//, "", b); if (b == branch) print wt }
    '
}

# Branch a worktree directory is named for: the one whose slug ('/' → '-', the
# same flattening cmd_switch applies) equals the directory's basename. Echoes
# nothing when no local branch matches or the name is ambiguous.
branch_for_worktree_dir() {
    local want
    want=$(basename "$1")
    git for-each-ref --format='%(refname:short)' refs/heads | awk -v want="$want" '
        { slug = $0; gsub(/\//, "-", slug); if (slug == want) { n++; found = $0 } }
        END { if (n == 1) print found }
    '
}

# File holding the branch a worktree was created for. It lives in the tree's own
# git dir, which sits outside the working tree, so git never reports it.
owning_branch_file() {
    local gitdir
    gitdir=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null) || return 1
    printf '%s\n' "$gitdir/gwt-owning-branch"
}

record_owning_branch() {
    local f
    f=$(owning_branch_file "$1") || return 0
    printf '%s\n' "$2" >"$f" 2>/dev/null || true
}

# The branch a worktree belongs to: what gwt recorded when it created the tree,
# else the branch its directory is named for. The record is what makes this work
# on a tree whose directory name and branch have drifted apart; the name rule
# covers trees created before the record existed, or by hand. Echoes nothing
# when neither answers.
owning_branch() {
    local f own
    if f=$(owning_branch_file "$1") && [[ -r "$f" ]]; then
        own=$(<"$f")
        if [[ -n "$own" ]] && git -C "$1" show-ref --verify --quiet "refs/heads/${own}"; then
            printf '%s\n' "$own"
            return 0
        fi
    fi
    branch_for_worktree_dir "$1"
}

# Move <dir> off <branch> and back onto the branch its name says it holds, so
# <branch> is free to get a worktree of its own. Returns non-zero, leaving the
# tree untouched, when the owning branch can't be identified, when tracked
# changes would ride along, or when the checkout fails (e.g. the owning branch
# is checked out in a third tree).
reclaim_stray_checkout() {
    local dir="$1" branch="$2" own
    own=$(owning_branch "$dir")
    if [[ -z "$own" || "$own" == "$branch" ]]; then
        echo "Note: $branch is checked out in $dir; cannot tell which branch that tree belongs to." >&2
        return 1
    fi
    if [[ -n "$(git -C "$dir" status --porcelain --untracked-files=no)" ]]; then
        echo "Note: $branch is checked out in $dir, which belongs to $own, but that tree has uncommitted changes." >&2
        return 1
    fi
    echo "Restoring $dir to $own"
    git -C "$dir" checkout --quiet "$own" || return 1
}

# Clear a lock on a worktree if one is set. gwt-created worktrees can be locked
# by external tooling (e.g. a Claude Code session tags the tree with its PID);
# when that process dies the lock is left stale and blocks `git worktree remove`.
# Unlocking is a no-op when the tree isn't locked, so this is safe to call
# unconditionally before removal.
unlock_worktree() {
    git worktree unlock "$1" 2>/dev/null || true
}

# Resolve a user-supplied ref to a branch name.
# Accepts a branch name, a PR number (#123 or 123), or a GitHub PR URL.
resolve_branch() {
    local input="$1"
    local pr_num=""

    # GitHub PR URL: https://github.com/owner/repo/pull/123
    if [[ "$input" =~ github\.com/[^/]+/[^/]+/pull/([0-9]+) ]]; then
        pr_num="${BASH_REMATCH[1]}"
    # Explicit PR form: #123
    elif [[ "$input" =~ ^#([0-9]+)$ ]]; then
        pr_num="${BASH_REMATCH[1]}"
    # Bare number: try as PR first, fall back to literal branch name
    elif [[ "$input" =~ ^[0-9]+$ ]]; then
        pr_num="$input"
    fi

    if [[ -n "$pr_num" ]]; then
        if ! command -v gh &>/dev/null; then
            if [[ "$input" != "$pr_num" ]]; then
                echo "Error: gh CLI is required to resolve PR $input" >&2
                return 1
            fi
        else
            local branch
            if branch=$(gh pr view "$pr_num" --json headRefName --jq .headRefName 2>/dev/null) \
                && [[ -n "$branch" ]]; then
                echo "$branch"
                return 0
            fi
            # Explicit PR syntax must resolve; bare number can fall through as branch
            if [[ "$input" != "$pr_num" ]]; then
                echo "Error: could not resolve PR $input via gh" >&2
                return 1
            fi
        fi
    fi

    echo "$input"
    return 0
}

# Check if a branch has been merged into the default branch.
# Handles fast-forward/merge commits (ancestor check) and squash/rebase
# merges (patch-equivalence via git cherry).
is_branch_merged() {
    local branch="$1"
    local default_branch="$2"

    # Prefer origin/<default> for freshness, fall back to local.
    local target=""
    if git rev-parse --verify "refs/remotes/origin/$default_branch" &>/dev/null; then
        target="refs/remotes/origin/$default_branch"
    elif git rev-parse --verify "refs/heads/$default_branch" &>/dev/null; then
        target="refs/heads/$default_branch"
    else
        return 1
    fi

    # Ancestor: normal or fast-forward merge.
    if git merge-base --is-ancestor "refs/heads/$branch" "$target" 2>/dev/null; then
        return 0
    fi

    # Patch-equivalent: squash or rebase merge. git cherry marks each commit
    # on $branch with '+' if absent from $target or '-' if already applied.
    local output
    output=$(git cherry "$target" "refs/heads/$branch" 2>/dev/null) || return 1
    [[ -z "$output" ]] && return 1
    if ! grep -q '^+' <<< "$output"; then
        return 0
    fi

    return 1
}

# Check if the PR for a branch has been merged on GitHub.
# Requires the gh CLI; returns non-zero (treated as "not merged") if gh is
# unavailable, no PR exists for the branch, or the PR is still open/closed.
is_branch_pr_merged() {
    local branch="$1"
    command -v gh &>/dev/null || return 1

    local state
    state=$(gh pr view "$branch" --json state --jq .state 2>/dev/null) || return 1
    [[ "$state" == "MERGED" ]]
}

# Derive tmux session name from a worktree path
session_name_for_path() {
    local name
    name="$(basename "$1")"
    echo "${name//[.:]/-}"
}

# Kill the tmux session associated with a worktree path.
# If we're currently in that session, switch to the main repo session first.
kill_worktree_tmux_session() {
    local wt_path="$1"
    local main_worktree="$2"

    [[ -z "${TMUX:-}" ]] && return

    local session_name
    session_name=$(session_name_for_path "$wt_path")

    if ! tmux has-session -t "=$session_name" 2>/dev/null; then
        return
    fi

    # If we're in the session being killed, switch to main repo session first
    local current_session
    current_session=$(tmux display-message -p '#S')
    if [[ "$current_session" == "$session_name" ]]; then
        local main_session
        main_session=$(session_name_for_path "$main_worktree")
        # Create main session if it doesn't exist
        if ! tmux has-session -t "=$main_session" 2>/dev/null; then
            tmux new-session -d -s "$main_session" -c "$main_worktree"
        fi
        tmux switch-client -t "=$main_session"
    fi

    tmux kill-session -t "=$session_name"
    echo "Killed tmux session: $session_name"
}

# Move the *interactive* shell to a new directory. gwt runs as a child process,
# so it can't cd its parent; instead the gwt() shell wrapper (in .zshrc_alias)
# passes a temp path via $GWT_CD_FILE and cds there after we exit. Falls back to
# the tmux send-keys hack when invoked directly without that wrapper.
emit_cd() {
    local dest="$1"
    if [[ -n "${GWT_CD_FILE:-}" ]]; then
        printf '%s\n' "$dest" > "$GWT_CD_FILE"
    elif [[ -n "${TMUX:-}" ]]; then
        tmux send-keys "cd '$dest'" Enter
    fi
}

# Paths symlinked from the main worktree into every new worktree, so git-ignored
# scratch space and local config are shared rather than recreated per tree.
GWT_DEFAULT_LINKS=(.scratch)

# Emit one link spec per line: the built-in defaults, then the repo's .gwt-links.
# Blank lines and '#' comments (whole-line or trailing) are dropped.
read_link_specs() {
    local main_worktree="$1"
    printf '%s\n' "${GWT_DEFAULT_LINKS[@]}"

    local links_file="${main_worktree}/.gwt-links"
    [[ -f "$links_file" ]] || return 0

    local line
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -n "$line" ]] && printf '%s\n' "$line"
    done < "$links_file"
}

# Symlink a single path into the new worktree. Missing sources are skipped (a
# spec may only apply to some repos), as is anything already present in the
# worktree — the checkout's own copy always wins.
link_one() {
    local src="$1" dest="$2" label="$3"

    if [[ ! -e "$src" && ! -L "$src" ]]; then
        return 0
    fi
    if [[ -e "$dest" || -L "$dest" ]]; then
        return 0
    fi

    mkdir -p "$(dirname "$dest")"
    if ln -s "$src" "$dest"; then
        echo "  linked $label -> $src"
    fi
}

# Apply the link specs to a worktree. Idempotent, so it's safe to re-run.
link_shared_paths() {
    local wt_path="$1"
    local main_worktree
    main_worktree=$(get_main_worktree)

    wt_path=$(cd "$wt_path" && pwd)
    [[ "$wt_path" == "$main_worktree" ]] && return 0

    local spec
    while IFS= read -r spec; do
        [[ -n "$spec" ]] || continue
        case "$spec" in
            /*|~*|../*)
                echo "  skipped '$spec': .gwt-links paths must be repo-relative" >&2
                continue
                ;;
        esac

        if [[ "$spec" != */ ]]; then
            link_one "$main_worktree/$spec" "$wt_path/$spec" "$spec"
            continue
        fi

        # Trailing slash: link the directory's *entries* instead of the directory
        # itself. Needed when a dir is only partly git-ignored — a symlink over
        # the whole dir would shadow the tracked files this checkout owns.
        local rel="${spec%/}"
        [[ -d "$main_worktree/$rel" ]] || continue
        mkdir -p "$wt_path/$rel"

        local entry name
        for entry in "$main_worktree/$rel"/* "$main_worktree/$rel"/.[!.]*; do
            [[ -e "$entry" || -L "$entry" ]] || continue
            name=$(basename "$entry")
            # Tracked here — leave the checkout's own copy alone.
            if git -C "$wt_path" ls-files --error-unmatch "$rel/$name" &>/dev/null; then
                continue
            fi
            link_one "$entry" "$wt_path/$rel/$name" "$rel/$name"
        done
    done < <(read_link_specs "$main_worktree")
}

# Setup status for a worktree, kept in its git dir like gwt-owning-branch so
# git never sees it. Holds "running <pid> <epoch>" or "done <exit> <epoch>".
setup_status_file() {
    local gitdir
    gitdir=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null) || return 1
    printf '%s\n' "$gitdir/gwt-setup-status"
}

# Start a command in its own session, detached from this process group. A plain
# `& disown` job still dies when herdr tears down the pane it was started from.
spawn_detached() {
    if command -v python3 >/dev/null 2>&1; then
        python3 -c '
import os, sys
if os.fork() != 0: os._exit(0)
os.setsid()
if os.fork() != 0: os._exit(0)
os.execvp(sys.argv[1], sys.argv[1:])
' "$@" </dev/null >/dev/null 2>&1
    else
        nohup "$@" </dev/null >/dev/null 2>&1 &
        disown 2>/dev/null || true
    fi
}

# Should the setup script run inside the worktree's direnv environment? Only
# when direnv is installed and the tree's .envrc is byte-identical to the main
# checkout's, so a branch cannot get an arbitrary .envrc auto-trusted. Prints
# the reason to skip on stdout when the answer is no.
direnv_gate() {
    local wt_path="$1" main_worktree="$2"
    [[ -f "$wt_path/.envrc" ]] || return 1
    if ! command -v direnv >/dev/null 2>&1; then
        echo "direnv not installed; running setup without it"
        return 1
    fi
    if ! cmp -s "$main_worktree/.envrc" "$wt_path/.envrc"; then
        echo "WARNING: .envrc differs from the main worktree's; running setup without direnv"
        return 1
    fi
    return 0
}

# Run the repo's .gwt-setup for a worktree, once. The status file is the lock:
# a run that already succeeded, failed, or is still going is left alone, and a
# failure is reported rather than retried since each attempt can cost minutes.
# --force clears the status and runs again. The script itself runs detached (see
# cmd_run_setup) so callers return at once; output -> <worktree>/.gwt-setup.log.
run_setup_script() {
    local worktree_path="$1" force="${2:-0}"
    local main_worktree
    main_worktree=$(get_main_worktree)
    local setup_script="${main_worktree}/.gwt-setup"

    [[ -f "$setup_script" ]] || return 0
    [[ "$worktree_path" == "$main_worktree" ]] && return 0

    local status_file
    status_file=$(setup_status_file "$worktree_path") || return 0
    local log="${worktree_path}/.gwt-setup.log"

    if [[ "$force" == "1" ]]; then
        rm -f "$status_file"
    elif [[ -f "$status_file" ]]; then
        local state arg
        read -r state arg _ <"$status_file" || true
        case "$state" in
            done)
                if [[ "$arg" == "0" ]]; then
                    echo "Setup already done."
                else
                    echo "Setup previously FAILED (exit $arg). See $log; rerun with: gwt hydrate --force"
                fi
                return 0 ;;
            running)
                if kill -0 "$arg" 2>/dev/null; then
                    echo "Setup already running (pid $arg): tail -f '$log'"
                else
                    echo "Setup previously CRASHED (pid $arg gone). See $log; rerun with: gwt hydrate --force"
                fi
                return 0 ;;
        esac
    fi

    local use_direnv=0
    if direnv_gate "$worktree_path" "$main_worktree"; then
        use_direnv=1
    fi

    # Claim the run atomically; a concurrent gwt that loses the race skips.
    if ! (set -o noclobber; printf 'running %s %s\n' "$$" "$(date +%s)" >"$status_file") 2>/dev/null; then
        echo "Setup already claimed by another gwt."
        return 0
    fi

    echo "Running setup script in background: $setup_script"
    echo "  logs -> $log  (tail -f '$log')"
    spawn_detached "$GWT_SELF" __run-setup "$worktree_path" "$setup_script" "$use_direnv" "$status_file"
}

# Detached worker behind run_setup_script. Owns the status file from here on:
# records its own pid, runs the script (inside `direnv exec` when the gate
# passed), and writes the exit code to both the log and the status file.
cmd_run_setup() {
    local worktree_path="$1" setup_script="$2" use_direnv="$3" status_file="$4"
    local log="${worktree_path}/.gwt-setup.log"
    if [[ ! -d "$worktree_path" ]]; then
        printf 'done 1 %s\n' "$(date +%s)" >"$status_file"
        return 0
    fi
    printf 'running %s %s\n' "$$" "$(date +%s)" >"$status_file"

    # Subshell, so any failure lands in rc and gets recorded.
    local rc=0
    (
        cd "$worktree_path" || exit 1
        local -a runner
        if [[ -x "$setup_script" ]]; then runner=("$setup_script"); else runner=(bash "$setup_script"); fi
        if [[ "$use_direnv" == "1" ]]; then
            echo "gwt: direnv allow . && direnv exec . ${runner[*]}"
            direnv allow . && direnv exec . "${runner[@]}"
        else
            echo "gwt: ${runner[*]}"
            "${runner[@]}"
        fi
    ) >"$log" 2>&1 || rc=$?

    echo "exit=$rc" >>"$log"
    printf 'done %s %s\n' "$rc" "$(date +%s)" >"$status_file"
}

# Bring a worktree to the hydrated state: owning branch recorded, shared paths
# linked, setup run once. Every step is idempotent, so this is safe to call on
# any tree at any time, however it was created. The main checkout is left alone.
hydrate_worktree() {
    local wt_path="$1" branch="${2:-}" force="${3:-0}" no_setup="${4:-0}"
    wt_path=$(cd "$wt_path" && pwd)
    local main_worktree
    main_worktree=$(git -C "$wt_path" worktree list --porcelain | head -1 | sed 's/^worktree //')
    if [[ "$wt_path" == "$main_worktree" ]]; then
        echo "Main worktree; nothing to hydrate."
        return 0
    fi

    local f
    if [[ -n "$branch" ]]; then
        record_owning_branch "$wt_path" "$branch"
    elif f=$(owning_branch_file "$wt_path") && [[ ! -s "$f" ]]; then
        branch=$(git -C "$wt_path" symbolic-ref --quiet --short HEAD 2>/dev/null) || branch=""
        [[ -n "$branch" ]] && record_owning_branch "$wt_path" "$branch"
    fi

    # The helpers below resolve the repo from cwd; run them from inside the tree
    # without moving the caller.
    (
        cd "$wt_path"
        link_shared_paths "$wt_path"
        [[ "$no_setup" == "1" ]] || run_setup_script "$wt_path" "$force"
    )
}

# The block gwt prepends to the repo's post-checkout hook. git runs that hook
# inside the new worktree after `git worktree add`, from any caller, with the
# null SHA as $1; a plain checkout has a real previous HEAD and skips the block.
# gwt's own commands set GWT_HOOK_SKIP since they hydrate explicitly after the
# add. Whatever hook was already there (husky's, lefthook's, hand-written)
# follows the block untouched, so its behaviour and its `$0` are preserved.
GWT_HOOK_MARKER="# gwt-hook: hydrate new worktrees (managed by \`gwt hooks\`)"
GWT_HOOK_END="# gwt-hook-end"
post_checkout_hook_block() {
    cat <<EOF
$GWT_HOOK_MARKER
if [ "\$1" = "0000000000000000000000000000000000000000" ] && [ -z "\$GWT_HOOK_SKIP" ]; then
    (unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE; "$GWT_SELF" hydrate "\$(pwd)" </dev/null) || true
fi
$GWT_HOOK_END
EOF
}

# Make sure the repo's post-checkout hook starts with gwt's block. Honours
# core.hooksPath, so this lands in husky's or a repo's own hooks dir when one is
# configured. Hook managers regenerate their files and drop the block; every gwt
# command calls this, so it comes back the next time gwt runs in the repo.
ensure_post_checkout_hook() {
    local quiet="${1:-0}"
    local main_worktree hooks_dir hook
    main_worktree=$(get_main_worktree)
    hooks_dir=$(cd "$main_worktree" && git rev-parse --path-format=absolute --git-path hooks)
    hook="$hooks_dir/post-checkout"

    local current="" original=""
    [[ -f "$hook" ]] && current=$(<"$hook")
    if [[ -n "$current" ]]; then
        if grep -qF -- "$GWT_HOOK_END" "$hook"; then
            original=$(sed "1,/^$GWT_HOOK_END\$/d" "$hook")
        else
            original=$(sed '1{/^#!/d;}' "$hook")
        fi
    fi

    local body
    body="#!/bin/sh"$'\n'"$(post_checkout_hook_block)"
    [[ -n "$original" ]] && body+=$'\n'"$original"

    if [[ "$current" == "$body" ]]; then
        [[ "$quiet" == "1" ]] || echo "gwt post-checkout hook in place: $hook"
        return 0
    fi
    mkdir -p "$hooks_dir"
    printf '%s\n' "$body" >"$hook"
    chmod +x "$hook"
    if [[ -n "$original" ]]; then
        echo "Installed gwt post-checkout hook ahead of the existing one: $hook"
    else
        echo "Installed gwt post-checkout hook: $hook"
    fi
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_switch() {
    # Join all arguments with hyphens: "gwt switch a b c" → "a-b-c"
    local input="${*}"
    input="${input// /-}"

    # No argument — fzf picker over existing worktrees
    if [[ -z "$input" ]]; then
        local main_worktree
        main_worktree=$(get_main_worktree)

        # Display column (field 1) shows the worktree dir name and its branch,
        # with a "(main)" marker for the primary worktree; fields 2/3 hold the
        # raw branch/path for the cut calls below.
        local selected
        selected=$(git worktree list --porcelain | awk -v main="$main_worktree" '
            /^worktree / { wt = substr($0, 10) }
            /^branch /   {
                b = substr($0, 8); sub(/^refs\/heads\//, "", b);
                n = split(wt, parts, "/"); dir = parts[n];
                if (length(dir) > 28) dir = substr(dir, 1, 26) "..";
                marker = (wt == main) ? " (main)" : "";
                disp = sprintf("%-28s %s%s", dir, b, marker);
                print disp "\t" b "\t" wt
            }
        ' | fzf --delimiter='\t' --with-nth=1 --preview 'echo {3}' --prompt="Switch to worktree> ")

        if [[ -z "$selected" ]]; then
            return
        fi

        local branch wt_path
        branch=$(echo "$selected" | cut -f2)
        wt_path=$(echo "$selected" | cut -f3)

        open_session "$branch" "$wt_path"
        return
    fi

    # Argument given — create worktree if needed, then switch.
    # PR references (pull URL, #N, or a bare PR number) resolve to the PR's
    # head branch via resolve_branch, so they open a normal branch worktree.
    local branch
    branch=$(resolve_branch "$input") || exit 1
    if [[ "$branch" != "$input" ]]; then
        echo "Resolved $input → $branch"
    fi

    local main_worktree
    main_worktree=$(get_main_worktree)
    local repo
    repo=$(basename "$main_worktree")

    # Worktree path: nested under a per-repo dir, with '/' in the branch flattened
    # so "feat/foo" → "<repo>/feat-foo" (one dir per branch, not deeper nesting).
    local branch_slug="${branch//\//-}"
    local wt_root
    wt_root=$(worktrees_dir)
    local wt_path="${wt_root}/${repo}/${branch_slug}"

    # Check if a worktree already exists for this branch
    local existing_wt
    existing_wt=$(find_worktree_for_branch "$branch")

    # A branch checked out in some other tree's directory (someone ran git
    # checkout in there) is a hijacked tree, not this branch's worktree: hand
    # that directory back to its own branch so the switch below can create the
    # worktree the branch should have had. Reclaiming can decline, in which case
    # we fall back to opening the tree where the branch actually sits.
    if [[ -n "$existing_wt" && "$existing_wt" != "$main_worktree" \
          && "$(basename "$existing_wt")" != "$branch_slug" ]]; then
        if reclaim_stray_checkout "$existing_wt" "$branch"; then
            existing_wt=""
        fi
    fi

    if [[ -n "$existing_wt" ]]; then
        # Worktree exists — open it in a tmux session
        echo "Worktree already exists: $existing_wt"
        open_session "$branch" "$existing_wt"
        return
    fi

    # Path already exists on disk (e.g. stale/deregistered worktree) — just open it
    if [[ -d "$wt_path" ]]; then
        wt_path=$(cd "$wt_path" && pwd)
        echo "Directory already exists: $wt_path"
        open_session "$branch" "$wt_path"
        return
    fi

    ensure_post_checkout_hook 1

    # Check if branch exists (locally or in origin)
    if git show-ref --verify --quiet "refs/heads/${branch}" 2>/dev/null; then
        # Local branch exists — create worktree from it
        GWT_HOOK_SKIP=1 git worktree add "$wt_path" "$branch"
    elif git fetch origin "$branch" 2>/dev/null && \
         git show-ref --verify --quiet "refs/remotes/origin/${branch}" 2>/dev/null; then
        # Remote branch exists — create worktree tracking it
        GWT_HOOK_SKIP=1 git worktree add "$wt_path" "$branch"
    else
        # Branch doesn't exist — create from the current branch (fall back to
        # the default branch if HEAD is detached or unavailable).
        local base
        base=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
        if [[ -z "$base" || "$base" == "HEAD" ]]; then
            base=$(get_default_branch)
        fi
        GWT_HOOK_SKIP=1 git worktree add -b "$branch" "$wt_path" "$base"
    fi

    wt_path=$(cd "$wt_path" && pwd)
    hydrate_worktree "$wt_path" "$branch"

    # Open in tmux
    open_session "$branch" "$wt_path"
}

# Hydrate a worktree (default: the current one) however it was created: record
# the owning branch, link shared paths, run .gwt-setup once. Idempotent.
cmd_hydrate() {
    local force=0 no_setup=0 wt_path=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force)    force=1; shift ;;
            --no-setup) no_setup=1; shift ;;
            -*) echo "Unknown option: $1"; exit 1 ;;
            *)  wt_path="$1"; shift ;;
        esac
    done
    [[ -n "$wt_path" ]] || wt_path=$(git rev-parse --show-toplevel 2>/dev/null) || wt_path=""
    if [[ -z "$wt_path" || ! -d "$wt_path" ]] || ! git -C "$wt_path" rev-parse --git-dir &>/dev/null; then
        echo "Error: not a git worktree: ${wt_path:-$PWD}" >&2
        exit 1
    fi
    # The target may belong to a different repo than cwd; the hook goes in its repo.
    (cd "$wt_path" && ensure_post_checkout_hook 1)
    hydrate_worktree "$wt_path" "" "$force" "$no_setup"
}

# Install (or report on) the post-checkout hook that hydrates worktrees created
# outside gwt, e.g. by a plain `git worktree add`. --quiet only speaks when it
# changes something, for use from a session-start hook.
cmd_hooks() {
    local quiet=0
    [[ "${1:-}" == "--quiet" ]] && quiet=1
    ensure_post_checkout_hook "$quiet"
}

cmd_delete() {
    local force=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--force) force=1; shift ;;
            *) echo "Unknown option: $1"; exit 1 ;;
        esac
    done

    local main_worktree
    main_worktree=$(get_main_worktree)
    local current_dir
    current_dir=$(pwd)

    # Build list of secondary worktrees for fzf
    local worktrees
    worktrees=$(git worktree list --porcelain | awk -v main="$main_worktree" '
        /^worktree / { wt = substr($0, 10) }
        /^branch /   { b = substr($0, 8); sub(/^refs\/heads\//, "", b); if (wt != main) print b "\t" wt }
    ')

    if [[ -z "$worktrees" ]]; then
        echo "No secondary worktrees to delete"
        exit 0
    fi

    # Find current worktree's branch to use as fzf default
    local current_branch=""
    while IFS=$'\t' read -r b wt; do
        if [[ "$current_dir" == "$wt"* ]]; then
            current_branch="$b"
            break
        fi
    done <<< "$worktrees"

    local fzf_opts=(--delimiter='\t' --with-nth=1 --prompt="Delete worktree> ")
    if [[ -n "$current_branch" ]]; then
        fzf_opts+=(--query="$current_branch" --select-1)
    fi

    local selected
    selected=$(echo "$worktrees" | fzf "${fzf_opts[@]}")

    if [[ -z "$selected" ]]; then
        return
    fi

    local branch wt_path
    branch=$(echo "$selected" | cut -f1)
    wt_path=$(echo "$selected" | cut -f2)

    echo "Removing worktree: $wt_path (branch: $branch)"

    # Remove the worktree + tear down its session (native herdr path when
    # possible, git fallback otherwise). Keeps the branch.
    remove_worktree "$wt_path" "$main_worktree" "$force" || return
}

cmd_setup() {
    local main_worktree
    main_worktree=$(get_main_worktree)
    local setup_script="${main_worktree}/.gwt-setup"

    "${EDITOR:-vim}" "$setup_script"
}

cmd_links() {
    local apply=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --apply) apply=1; shift ;;
            *) echo "Unknown option: $1"; exit 1 ;;
        esac
    done

    # --apply retrofits the current worktree, for links added after it was created.
    if [[ "$apply" == "1" ]]; then
        local toplevel
        toplevel=$(git rev-parse --show-toplevel)
        echo "Linking shared paths into $toplevel"
        link_shared_paths "$toplevel"
        return
    fi

    local main_worktree
    main_worktree=$(get_main_worktree)
    "${EDITOR:-vim}" "${main_worktree}/.gwt-links"
}

# Put the current worktree back on the branch its directory name says it holds,
# undoing a `git checkout` made inside a gwt tree. Backs the `_` shell function,
# so it stays quiet and succeeds in every case it declines to act: outside a
# worktree, in the main checkout, on a detached HEAD, or already on the right
# branch. Only a wrong branch it cannot fix is worth a word.
cmd_reclaim() {
    local dir branch own
    dir=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
    [[ "$dir" != "$(get_main_worktree)" ]] || return 0
    branch=$(git -C "$dir" symbolic-ref --quiet --short HEAD) || return 0
    own=$(owning_branch "$dir")
    [[ -n "$own" && "$own" != "$branch" ]] || return 0

    if [[ -n "$(git -C "$dir" status --porcelain --untracked-files=no)" ]]; then
        echo "On $branch, not this tree's $own — uncommitted changes." >&2
        return 0
    fi
    echo "Restoring to $own"
    git -C "$dir" checkout --quiet "$own"
}

cmd_purge() {
    local main_worktree
    main_worktree=$(get_main_worktree)
    local default_branch
    default_branch=$(get_default_branch)

    # Refresh origin/<default> so squash-merged branches are detected.
    echo "Fetching origin/$default_branch..."
    git fetch origin "$default_branch" 2>/dev/null || true

    local entries=()
    while IFS=$'\t' read -r branch wt; do
        [[ -z "$branch" ]] && continue
        [[ "$wt" == "$main_worktree" ]] && continue
        [[ "$branch" == "$default_branch" ]] && continue

        # Merged locally (fast/ancestor or squash/rebase patch-equivalence),
        # or its PR has been merged on GitHub. The local check runs first so
        # the gh network call is only made when needed.
        if is_branch_merged "$branch" "$default_branch" || is_branch_pr_merged "$branch"; then
            entries+=("$branch"$'\t'"$wt")
        fi
    done < <(git worktree list --porcelain | awk '
        /^worktree / { wt = substr($0, 10) }
        /^branch /   { b = substr($0, 8); sub(/^refs\/heads\//, "", b); print b "\t" wt }
    ')

    if [[ ${#entries[@]} -eq 0 ]]; then
        echo "No merged worktrees to purge"
        return
    fi

    echo
    echo "Worktrees whose branch (or its PR) is merged into $default_branch:"
    for entry in "${entries[@]}"; do
        local b="${entry%%$'\t'*}"
        local w="${entry##*$'\t'}"
        printf "  %s  →  %s\n" "$b" "$w"
    done
    echo

    local reply
    read -rp "Remove these worktrees and delete their branches? (y/N) " reply
    if [[ "$reply" != "y" && "$reply" != "Y" ]]; then
        echo "Aborted"
        return
    fi

    # Remove each worktree + tear down its session. The one we're sitting in (if
    # any) goes LAST: native herdr removal of the current workspace can tear down
    # this pane and kill gwt mid-loop, so purge the others first. Branches were
    # verified merged above, so force-removal and force branch-delete are safe.
    local current_dir current_entry=""
    current_dir=$(pwd)
    for entry in "${entries[@]}"; do
        local w="${entry##*$'\t'}"
        if [[ "$current_dir" == "$w"* ]]; then current_entry="$entry"; continue; fi
        local b="${entry%%$'\t'*}"
        echo "Removing worktree: $w"
        remove_worktree "$w" "$main_worktree" 1 || continue
        git -C "$main_worktree" branch -D "$b" 2>/dev/null || true
    done

    if [[ -n "$current_entry" ]]; then
        local b="${current_entry%%$'\t'*}"
        local w="${current_entry##*$'\t'}"
        echo "Removing worktree: $w"
        remove_worktree "$w" "$main_worktree" 1 || return
        # Native removal of our own workspace may kill gwt before this runs; the
        # branch can only be dropped after removal (it's checked out until then),
        # so a merged branch that lingers here is harmless — the next purge or
        # clean-gone will delete it.
        git -C "$main_worktree" branch -D "$b" 2>/dev/null || true
    fi
}

# ---------------------------------------------------------------------------
# Multiplexer session integration
#
# gwt drives either tmux or herdr, depending on where it runs. Each worktree
# gets its own session (tmux) / workspace (herdr); the dispatchers below pick
# the right backend so `switch`/`delete`/`purge` work in both.
# ---------------------------------------------------------------------------

in_herdr() { [[ -n "${HERDR_PANE_ID:-}" ]]; }

# Report the worktree gwt settled on to its caller: set $GWT_WT_FILE and gwt
# writes "<branch>\t<path>" there. Used by ~/bin/herdr-gwt-prompt to find the
# workspace to open a PR diff in, instead of re-deriving the path itself.
emit_worktree() {
    [[ -n "${GWT_WT_FILE:-}" ]] || return 0
    printf '%s\t%s\n' "$1" "$2" > "$GWT_WT_FILE"
}

# Create or focus a session/workspace for a worktree.
open_session() {
    emit_worktree "$@"
    if in_herdr; then open_in_herdr "$@"; else open_in_tmux "$@"; fi
}

# Tear down the session/workspace associated with a worktree path.
close_worktree_session() {
    if in_herdr; then close_worktree_herdr "$@"; else kill_worktree_tmux_session "$@"; fi
}

# Remove a worktree's checkout and tear down its multiplexer session.
#
# In herdr, first try the native `herdr worktree remove`: for a herdr-managed
# worktree it removes the git worktree, closes the workspace, and refocuses the
# parent repo — atomically, server-side, keeping the branch. Because it's one
# server call, gwt doesn't need to outlive the pane teardown (this is what makes
# the setsid-daemon dance in close_worktree_herdr unnecessary here). It refuses
# a dirty worktree unless force=1, mirroring `git worktree remove`.
#
# Anything herdr doesn't manage as a worktree (Claude Code's .claude/worktrees
# spaces, plain workspaces), tmux, or any native failure (incl. dirty-without
# -force) falls through to `git worktree remove` + close_worktree_session.
#
# The caller deletes the branch afterwards if it wants to — native remove keeps
# it. Args: <wt_path> <main_worktree> <force:0|1>. Returns non-zero if removal
# failed (e.g. dirty without force).
remove_worktree() {
    local wt_path="$1" main_worktree="$2" force="$3"

    if in_herdr; then
        local abs wsid
        abs=$(cd "$wt_path" 2>/dev/null && pwd || echo "$wt_path")
        wsid=$(herdr_workspace_for_path "$abs")
        if [[ -n "$wsid" ]]; then
            local args=(--workspace "$wsid")
            [[ "$force" == "1" ]] && args+=(--force)
            # Success closes the workspace, which may kill this pane (and gwt)
            # mid-call — but the removal+refocus already happened server-side, so
            # that's a clean outcome. Only a genuine failure returns here without
            # a result, and it leaves the worktree untouched → git fallback.
            if herdr worktree remove "${args[@]}" --json 2>&1 | grep -q '"result"'; then
                return 0
            fi
        fi
    fi

    # --- git + session-teardown fallback ---
    unlock_worktree "$wt_path"
    local remove_args=("$wt_path")
    [[ "$force" == "1" ]] && remove_args=(--force "$wt_path")

    # If we're inside the worktree being removed, jump to main first.
    if [[ "$(pwd)" == "$wt_path"* ]]; then
        cd "$main_worktree"
        git worktree remove "${remove_args[@]}" || return 1
        emit_cd "$main_worktree"
    else
        git worktree remove "${remove_args[@]}" || return 1
    fi
    close_worktree_session "$wt_path" "$main_worktree"
}

open_in_tmux() {
    local branch="$1"
    local wt_path="$2"

    local session_name
    session_name=$(session_name_for_path "$wt_path")

    if [[ -z "${TMUX:-}" ]]; then
        # Not in tmux — create or attach to session
        if tmux has-session -t "=$session_name" 2>/dev/null; then
            tmux attach-session -t "=$session_name"
        else
            tmux new-session -d -s "$session_name" -c "$wt_path"
            tmux attach-session -t "=$session_name"
        fi
        return
    fi

    # Already in tmux — create or switch to session
    if tmux has-session -t "=$session_name" 2>/dev/null; then
        tmux switch-client -t "=$session_name"
    else
        tmux new-session -d -s "$session_name" -c "$wt_path"
        tmux switch-client -t "=$session_name"
    fi
}

# Find the herdr workspace already rooted at a worktree path. Match first on the
# git checkout path herdr tracks per workspace (robust), then fall back to the
# dir-basename label (workspaces opened before herdr indexed the worktree).
herdr_workspace_for_path() {
    local wt_path="$1" label
    label=$(basename "$wt_path")
    herdr workspace list 2>/dev/null | jq -r --arg p "$wt_path" --arg l "$label" '
        (.result.workspaces // [])
        | ( map(select(.worktree.checkout_path == $p))
          + map(select(.label == $l)) )
        | (.[0].workspace_id // empty)'
}

open_in_herdr() {
    local branch="$1"
    local wt_path="$2"

    wt_path=$(cd "$wt_path" && pwd)
    local label
    label=$(basename "$wt_path")

    # Open it as a native herdr worktree so herdr tracks the git checkout (badge,
    # worktree list, remove confirmation) instead of a generic space. Idempotent:
    # herdr reconciles by checkout path, focusing the existing workspace — and
    # upgrading a plain space's metadata — if it's already open.
    #
    # --cwd the main worktree: herdr rejects worktree open/create actions whose
    # source is a *linked* worktree (error "linked_worktree_source"), so anchor
    # the call to the repo's parent workspace instead of gwt's caller — otherwise
    # it fails whenever invoked from a secondary worktree. The `|| true` keeps a
    # non-zero exit from aborting gwt under `set -e` so the fallback below runs.
    local main_worktree created wsid
    main_worktree=$(get_main_worktree)
    created=$(herdr worktree open --cwd "$main_worktree" --path "$wt_path" --label "$label" --focus --json 2>/dev/null) || true
    wsid=$(printf '%s' "$created" | jq -r '.result.workspace.workspace_id // empty')

    # Fall back to a plain space if the path isn't a registered git worktree
    # (e.g. a stale directory) or `worktree open` is unavailable.
    if [[ -z "$wsid" ]]; then
        herdr workspace create --cwd "$wt_path" --label "$label" --focus >/dev/null 2>&1 || true
    fi
}

# Close the herdr workspace associated with a worktree path. Mirrors
# kill_worktree_tmux_session: when closing the workspace we're currently in,
# land back on the main repo's workspace instead of an arbitrary neighbour.
#
# Two herdr quirks force the approach below:
#   1. `workspace focus` before a close doesn't stick — closing a workspace makes
#      herdr re-home to the newest remaining one regardless. So the refocus must
#      happen *after* the close.
#   2. Closing our own workspace tears down the pane gwt runs in and kills every
#      process still living in it — including a `& disown` background job, which
#      stays in the pane's process group. So the close+refocus must be *fully*
#      detached (double-fork + setsid → new session, no controlling terminal) to
#      outlive the pane. macOS has no setsid(1), so we daemonize via python3.
close_worktree_herdr() {
    local wt_path="$1"
    local main_worktree="${2:-}"
    wt_path=$(cd "$wt_path" 2>/dev/null && pwd || echo "$wt_path")
    local wsid
    wsid=$(herdr_workspace_for_path "$wt_path")
    [[ -z "$wsid" ]] && return

    # Are we closing the workspace gwt itself is running in? Derive the current
    # workspace id from HERDR_PANE_ID (e.g. "w36:p1" → "w36"). This is reliable
    # regardless of focus state or whether the checkout still exists — unlike the
    # UI-global `.focused` flag, which by the time we get here has already moved
    # off the just-removed worktree, so the refocus-to-main branch never ran.
    local current_wsid="${HERDR_PANE_ID%%:*}"

    local main_id=""
    if [[ -n "$current_wsid" && "$wsid" == "$current_wsid" && -n "$main_worktree" ]]; then
        main_id=$(herdr_workspace_for_path "$(cd "$main_worktree" && pwd)")
        # Ensure the main repo's workspace exists so the detached refocus below
        # has a target (open_in_herdr creates it if missing).
        if [[ -z "$main_id" ]]; then
            open_in_herdr "" "$main_worktree"
            main_id=$(herdr_workspace_for_path "$(cd "$main_worktree" && pwd)")
        fi
    fi

    if [[ -n "$main_id" ]] && command -v python3 >/dev/null 2>&1; then
        # Fully detached daemon (double-fork + setsid): closing our own workspace
        # kills everything left in this pane's process group, so a plain
        # `& disown` job dies before it can refocus. A new session survives it.
        # The brief sleep lets gwt return and the pane settle before the close.
        python3 -c '
import os, sys, time, subprocess
if os.fork() != 0: os._exit(0)
os.setsid()
if os.fork() != 0: os._exit(0)
time.sleep(0.4)
subprocess.run(["herdr", "workspace", "close", sys.argv[1]])
subprocess.run(["herdr", "workspace", "focus", sys.argv[2]])
' "$wsid" "$main_id" </dev/null >/dev/null 2>&1
        echo "Closing herdr workspace $wsid; returning to $(basename "$main_worktree")"
    else
        herdr workspace close "$wsid" >/dev/null 2>&1
        echo "Closed herdr workspace: $wsid"
    fi
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

# Ensure we're in a git repo. hydrate takes the repo from its path argument and
# checks for itself; the setup worker inherits a valid cwd from hydrate.
case "${1:-}" in
    hydrate|__run-setup|-h|--help|"") ;;
    *)
        if ! git rev-parse --git-dir &>/dev/null; then
            echo "Error: not inside a git repository"
            exit 1
        fi ;;
esac

show_help() {
    echo "Usage: gwt <command> [args]"
    echo ""
    echo "Commands:"
    echo "  gwt switch [ref]  Switch to a worktree (fzf picker if no ref given)."
    echo "                    Creates the worktree if it doesn't exist."
    echo "                    <ref> may be a branch name, #PR, or PR URL"
    echo "                    (PR refs resolve to the PR's head branch)."
    echo "  gwt delete [-f]   Pick a worktree with fzf and remove it"
    echo "                    -f/--force removes even with uncommitted changes"
    echo "  gwt purge         Remove worktrees whose branches are merged"
    echo "  gwt reclaim       Check the current worktree back out onto the branch"
    echo "                    its directory is named for (what \`_\` calls)"
    echo "  gwt hydrate [--force] [--no-setup] [path]"
    echo "                    Link shared paths and run .gwt-setup on a worktree"
    echo "                    (default: current). Safe to repeat; setup runs once."
    echo "                    --force reruns a finished or failed setup"
    echo "                    --no-setup links only"
    echo "  gwt hooks         Install the git post-checkout hook that hydrates"
    echo "                    worktrees created outside gwt"
    echo "  gwt setup         Open .gwt-setup in \$EDITOR"
    echo "  gwt links [--apply]"
    echo "                    Open .gwt-links in \$EDITOR"
    echo "                    --apply links shared paths into the current worktree"
    echo ""
    echo "Shared paths:"
    echo "  New worktrees are symlinked to git-ignored paths in the main worktree."
    echo "  .scratch is always linked; list extra repo-relative paths in .gwt-links,"
    echo "  one per line. A path ending in a slash links the directory's entries"
    echo "  instead of the directory itself, leaving tracked files alone."
    echo ""
    echo "Setup:"
    echo "  Place a .gwt-setup script in your repo root. It runs once per new"
    echo "  worktree, detached in the background, under 'direnv exec .' when the"
    echo "  tree's .envrc matches the main checkout's. Output -> .gwt-setup.log;"
    echo "  status -> <git-dir>/gwt-setup-status."
}

case "${1:-}" in
    switch)        shift; cmd_switch "$@" ;;
    hydrate)       shift; cmd_hydrate "$@" ;;
    hooks)         shift; cmd_hooks "$@" ;;
    __run-setup)   shift; cmd_run_setup "$@" ;;
    setup)         shift; cmd_setup "$@" ;;
    links)         shift; cmd_links "$@" ;;
    delete)        shift; cmd_delete "$@" ;;
    purge)         shift; cmd_purge "$@" ;;
    reclaim)       shift; cmd_reclaim "$@" ;;
    -h|--help|"")  show_help ;;
    *)
        echo "Unknown command: $1"
        echo ""
        show_help
        exit 1
        ;;
esac
