#!/usr/bin/env bash
# herdr-claude <dir> <prompt> — start an interactive Claude Code session on
# <prompt> in a new tab of the herdr space rooted at <dir>, opening the space
# if none is live. Meant to be called from outside herdr (the Alfred "Ask
# Claude" workflow), so the session stays visible and can ask for approvals.
set -euo pipefail

# Alfred runs scripts with a bare PATH.
export PATH="$HOME/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

dir="${1:?usage: herdr-claude <dir> <prompt>}"
prompt="${2:?usage: herdr-claude <dir> <prompt>}"
dir="${dir/#\~/$HOME}"
model="${HERDR_CLAUDE_MODEL:-sonnet}"

# Focuses (or creates) the space and raises the terminal.
herdr-open-dir "$dir"
wsid=$(herdr workspace list | jq -r 'first(.result.workspaces[] | select(.focused) | .workspace_id) // empty')
[[ -n $wsid ]] || { echo "herdr-claude: no focused herdr space" >&2; exit 1; }

pane=$(herdr tab create --workspace "$wsid" --cwd "$dir" --focus |
    jq -r '.result.root_pane.pane_id')

# The new shell may not be at its prompt yet; it reads the typed line once it is.
herdr pane run "$pane" "claude --model $model $(printf '%q' "$prompt")" >/dev/null
