#!/usr/bin/env bash
# rex-snap-split — set the tab's left/right split to a ratio (prefix+( and prefix+)).
#
#   rex-snap-split <ratio> <pane> [<session>]   e.g. rex-snap-split 0.64 <pane>
#
# <ratio> is the share of the left side.
# - When the tab is split left/right at the top level, move that border.
# - Otherwise split <pane> and start claude on the right, which is what the
#   second pane is nearly always for. Set REX_SNAP_SPLIT_CMD to run something
#   else, or to an empty string for a plain shell.
set -euo pipefail

target="${1:?usage: rex-snap-split <ratio> <pane>}"
block="${2:?usage: rex-snap-split <ratio> <pane> [<session>]}"
sid="${3:-${REX_SESSION:?usage: rex-snap-split <ratio> <pane> <session>}}"
wid=$(rex block inspect -s "$sid" "$block" --json | jq -r '.block.window_id')

# The top-level split of the tab, as "<left pane>\t<right pane>" when it is a
# left/right split. A pane on each side of the border is enough for Rex to
# find the border.
border=$(rex api call -s "$sid" session.view '{}' | jq -r --arg w "$wid" '
    .windows[] | select(.window_id == $w) | .layers[] | select(.kind == "tiled")
    | .layout.split // empty | select(.direction == "horizontal")
    | "\([.before | .. | .block_id? // empty][0])\t\([.after | .. | .block_id? // empty][0])"')

resize() {
    rex api call -s "$sid" session.resize_pane "$(jq -nc \
        --arg b "$1" --arg a "$2" --argjson r "$target" \
        '{before_block_id: $b, after_block_id: $a, direction: "horizontal", ratio: $r}')" >/dev/null
}

if [[ -n $border ]]; then
    resize "${border%%$'\t'*}" "${border#*$'\t'}"
    exit 0
fi

cmd="${REX_SNAP_SPLIT_CMD-claude}"
if [[ -n $cmd ]]; then
    # Unquoted so the override can carry arguments.
    new=$(rex split -s "$sid" -b "$block" --split=right --focus=false --interactive --json -- $cmd)
else
    new=$(rex split -s "$sid" -b "$block" --split=right --focus=false --json)
fi
# With "Autobalance splits" on in Rex's settings, a new split always starts at
# half and ignores `rex split --ratio`, so the border is set afterwards.
resize "$block" "$(jq -r '.block_ids[0]' <<<"$new")"
