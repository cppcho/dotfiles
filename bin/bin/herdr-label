#!/usr/bin/env bash
# herdr-label <dir> — the label a herdr space rooted at <dir> gets.
#
# The root of a linked git worktree is "<repo>-<worktree dir>", so the agent
# panel says which repo a worktree belongs to; worktree directories are branch
# slugs, which alone don't. A main checkout is "<repo>", anything else the
# directory's basename.
#
# <repo> drops the first matching prefix listed one per line in the untracked
# ~/.herdr-label-strip-prefixes, so a prefix every repo shares doesn't eat the
# panel's width without naming it in this public repo.
set -euo pipefail

dir="${1:?usage: herdr-label <dir>}"
dir="${dir%/}"
label="${dir##*/}"

strip_prefix() {
    local name="$1" prefix f="$HOME/.herdr-label-strip-prefixes"
    if [[ -r $f ]]; then
        while IFS= read -r prefix || [[ -n $prefix ]]; do
            [[ -z $prefix || $prefix == \#* ]] && continue
            if [[ $name == "$prefix"?* ]]; then
                name="${name#"$prefix"}"
                break
            fi
        done <"$f"
    fi
    printf '%s' "$name"
}

# No pipe into head: under pipefail a repo with enough worktrees to fill the
# pipe buffer would SIGPIPE git and kill the script.
if [[ $(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) == "$dir" ]]; then
    main=$(git -C "$dir" worktree list --porcelain)
    main=${main%%$'\n'*}
    main=${main#worktree }
    if [[ -n $main ]]; then
        repo=$(strip_prefix "${main##*/}")
        if [[ $main == "$dir" ]]; then label=$repo; else label="$repo-$label"; fi
    fi
fi

printf '%s\n' "$label"
