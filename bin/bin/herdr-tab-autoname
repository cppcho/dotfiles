#!/usr/bin/env bash
# herdr-tab-autoname — tmux-style automatic-rename for herdr TABS.
#
# A tab running a coding agent is named from the terminal title the agent
# broadcasts, which Claude Code sets to a description of its current task. The
# last such title sticks, so a tab stays findable once its session goes quiet.
# Other tabs are named after their foreground process (nvim, git, lazygit, …),
# and a tab with nothing running shows its position within the workspace.
# Workspace labels are left untouched, so herdr-sessionizer's label matching
# keeps working.
#
# herdr has no hooks, so this polls the socket API. Run it as a background
# daemon (see ~/Library/LaunchAgents/com.cppcho.herdr-tab-autoname.plist):
#   herdr-tab-autoname            # poll forever
#   herdr-tab-autoname --dry      # print proposed renames once, apply nothing
#   herdr-tab-autoname --once     # one pass, apply
#   herdr-tab-autoname --adopt    # one pass, claiming tabs named before state
#                                 # was kept on disk (see below)
#
# Manual renames are preserved: once a tab's label differs from both its number
# and the last name we set, we stop managing it (like tmux allow-rename off).
# That ownership map is persisted, because holding it only in memory meant a
# daemon restart made every previously auto-named tab look hand-renamed and
# froze it for good. --adopt is the one-shot escape for tabs already frozen
# that way; it also claims genuine manual renames, so use it deliberately.
#
# Env:
#   HERDR_TAB_AUTONAME_INTERVAL   poll seconds (default 2)
#   HERDR_TAB_AUTONAME_MAX        label character budget (default 36)
#   HERDR_TAB_AUTONAME_STATE      state file path
set -uo pipefail

interval="${HERDR_TAB_AUTONAME_INTERVAL:-2}"
max_len="${HERDR_TAB_AUTONAME_MAX:-36}"
state_file="${HERDR_TAB_AUTONAME_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr-tab-autoname.state}"

mode="loop"
case "${1:-}" in
    --dry)   mode="dry" ;;
    --once)  mode="once" ;;
    --adopt) mode="adopt" ;;
esac

is_shell_re='^-?(zsh|bash|sh|fish|dash|tcsh|ksh|nu)$'

# Titles that name the agent rather than its work. An agent emits one of these
# before it has a task to describe, and a bare shell emits its cwd — identical
# across every tab in a workspace, so useless as a label.
generic_title_re='^(claude code|claude|codex|copilot|opencode|cursor|aider|amp)$'

declare -A last_set   # tab_id -> last label we assigned
declare -A sticky     # tab_id -> last work-describing title the tab produced
declare -A seen       # tab_id -> seen this pass

# Unit-separated, not tab-separated: tab is IFS whitespace, so read would
# collapse an empty ownership field and shift the sticky title into it.
load_state() {
    local tab managed stick
    [[ -r $state_file ]] || return 0
    while IFS=$'\037' read -r tab managed stick; do
        [[ -z $tab ]] && continue
        [[ -n $managed ]] && last_set[$tab]=$managed
        [[ -n $stick ]] && sticky[$tab]=$stick
    done <"$state_file"
}

# Only tabs seen this pass are written back, which prunes closed ones.
save_state() {
    local tmp tab
    mkdir -p "${state_file%/*}" 2>/dev/null || return 0
    tmp=$(mktemp "${state_file}.XXXXXX" 2>/dev/null) || return 0
    for tab in "${!seen[@]}"; do
        printf '%s\037%s\037%s\n' "$tab" "${last_set[$tab]-}" "${sticky[$tab]-}"
    done >"$tmp"
    mv -f "$tmp" "$state_file" 2>/dev/null || rm -f "$tmp"
}

# Claim a label as ours, or release the claim when the tab is back to its
# position number. Also called when the label already matches: skipping it there
# would leave an unclaimed label that the next restart reads as a manual rename.
claim_label() {
    local tab=$1 label=$2 pos=$3
    if [[ $label == "$pos" ]]; then unset 'last_set[$tab]'; else last_set[$tab]=$label; fi
}

is_meaningful_title() {
    local t="$1"
    [[ -z $t ]] && return 1
    [[ $t == [~/]* ]] && return 1
    [[ ${t,,} =~ $generic_title_re ]] && return 1
    return 0
}

truncate_label() {
    local s="$1"
    if (( ${#s} > max_len )); then
        printf '%s…' "${s:0:max_len-1}"
    else
        printf '%s' "$s"
    fi
}

# Desired label for a non-agent pane: the command name of the foreground
# process-group leader. Prefers argv0 over name (some apps set their process
# name to a version string). Empty for a bare shell or a gone pane.
pane_command() {
    local pane="$1" info cmd shell_pid tty fg
    info=$(herdr pane process-info --pane "$pane" 2>/dev/null) || return
    [[ -z $info ]] && return
    # Group leader = process whose pid == foreground_process_group_id.
    cmd=$(jq -r '(.result.process_info // {}) as $pi
        | ($pi.foreground_processes // []) as $fps
        | (($fps[] | select(.pid == $pi.foreground_process_group_id)) // $fps[-1] // {}) as $p
        | ($p.argv0 // $p.name // "")' 2>/dev/null <<<"$info")

    # herdr sometimes reports no foreground group (e.g. a `top` pane), only
    # shell_pid. Fall back to reading the tty's foreground process via ps.
    if [[ -z $cmd ]]; then
        shell_pid=$(jq -r '.result.process_info.shell_pid // empty' 2>/dev/null <<<"$info")
        tty=$(ps -o tty= -p "${shell_pid:-0}" 2>/dev/null | tr -d ' ')
        if [[ -n $tty && $tty != "?"* ]]; then
            fg=$(ps -t "$tty" -o pid=,pgid=,stat=,comm= 2>/dev/null | awk '$3 ~ /\+/')
            # Prefer the group leader (pid==pgid); else any foreground process.
            cmd=$(awk -v sh="${shell_pid:-0}" '$1==$2 && $1!=sh {print $4; exit}' <<<"$fg")
            [[ -z $cmd ]] && cmd=$(awk -v sh="${shell_pid:-0}" '$1!=sh {print $4; exit}' <<<"$fg")
        fi
    fi

    cmd=${cmd%% *}          # first token (drop args baked into argv0)
    cmd=${cmd##*/}          # basename
    cmd=${cmd#-}            # strip login-shell leading dash
    [[ -z $cmd || $cmd =~ $is_shell_re ]] && return
    printf '%s' "$cmd"
}

pass() {
    local snap tab pos rep agent cur title label
    seen=()
    snap=$(herdr api snapshot 2>/dev/null) || return
    [[ -z $snap ]] && return

    # Unit separator, not tab: labels and titles are free-form text and a tab
    # inside one would shift every field after it.
    while IFS=$'\037' read -r tab pos rep agent cur title; do
        [[ -z $tab ]] && continue
        seen[$tab]=1

        # Preserve manual renames: only manage tabs still on their default
        # numeric label or on a name we set ourselves.
        if [[ $mode != adopt && ! $cur =~ ^[0-9]+$ && $cur != "${last_set[$tab]-}" ]]; then
            continue
        fi
        [[ -z $rep ]] && continue

        if [[ -n $agent ]]; then
            if is_meaningful_title "$title"; then
                sticky[$tab]=$title
                label=$(truncate_label "$title")
            else
                # Between tasks the agent names only itself; hold the last real
                # description so the tab stays recognisable.
                label=$(truncate_label "${sticky[$tab]:-$agent}")
            fi
        else
            label=$(pane_command "$rep")
            if [[ -n $label ]]; then
                # Something else has taken the pane; the breadcrumb is spent.
                unset 'sticky[$tab]'
                label=$(truncate_label "$label")
            else
                label=$(truncate_label "${sticky[$tab]-}")
            fi
        fi

        # Nothing to say: show the tab's position within its workspace. Unlike
        # herdr's own .number, this is renumbered each pass so it stays
        # gap-free as tabs are created and closed.
        [[ -z $label ]] && label=$pos
        if [[ $label == "$cur" ]]; then
            claim_label "$tab" "$label" "$pos"
            continue
        fi

        if [[ $mode == "dry" ]]; then
            printf '%s: %q -> %q (pane %s)\n' "$tab" "$cur" "$label" "$rep"
        else
            herdr tab rename "$tab" "$label" >/dev/null 2>&1 \
                && claim_label "$tab" "$label" "$pos"
        fi
    done < <(jq -r '
        (.result.snapshot // {}) as $s
        | ($s.panes // []) as $panes
        | ($s.tabs // [])
        | group_by(.workspace_id)                       # stable: preserves tab order
        | map(to_entries | map(.value + {pos: (.key + 1)}))
        | add // []
        | .[] as $t
        | [$panes[] | select(.tab_id == $t.tab_id)] as $ps
        | [$ps[] | select(.agent != null and .agent != "")] as $ags
        | (first($ags[] | select(.focused)) // $ags[0]
           // first($ps[] | select(.focused)) // $ps[0] // {}) as $rep
        | [$t.tab_id, ($t.pos|tostring), ($rep.pane_id // ""), ($rep.agent // ""),
           ($t.label // ""), ($rep.terminal_title_stripped // "")]
        | join("\u001f")' 2>/dev/null <<<"$snap")

    [[ $mode == "dry" ]] || save_state
}

load_state
case "$mode" in
    dry|once|adopt) pass ;;
    loop)           while :; do pass; sleep "$interval"; done ;;
esac
