#!/usr/bin/env bash
# rex-nvim — show or hide this tab's editor (prefix+v).
#
#   rex-nvim <pane> [<session>]
#
# Each tab is one worktree (see rex-open), so each tab has its own editor: nvim
# in a floating pane labelled nvim, covering nearly the whole tab.
# - When the tab has no editor, open one, started in the tab's directory
#   (rex-root).
# - When the editor is minimized, or not focused, show and focus it.
# - When the editor has focus, minimize it, to see the panes under it.
#
# Quitting nvim closes its pane, so the next prefix+v opens a fresh one.
set -euo pipefail

block="${1:?usage: rex-nvim <pane> [<session>]}"
sid="${2:-${REX_SESSION:?usage: rex-nvim <pane> <session>}}"
wid=$(rex block inspect -s "$sid" "$block" --json | jq -r '.block.window_id')

editors=$(rex api call -s "$sid" session.list_blocks '{}' \
    | jq -c '[.blocks[] | select(.label == "nvim") | .block_id]')

# The editor's floating layer in this tab, as "<layer>\t<state>\t<pane>".
found=$(rex api call -s "$sid" session.view '{}' | jq -r --arg w "$wid" --argjson ed "$editors" '
    first(.windows[] | select(.window_id == $w) | .layers[] | select(.kind == "floating")
        | ([.layout | .. | .block_id? // empty] | map(select(IN($ed[])))[0]) as $b
        | select($b != null)
        | "\(.layer_id)\t\(.state // "normal")\t\($b)") // empty')

if [[ -n $found ]]; then
    IFS=$'\t' read -r layer state editor <<<"$found"
    if [[ $state != minimized && $editor == "$block" ]]; then
        args=$(jq -nc --arg l "$layer" '{layer_id: $l, state: "minimized", focus: false}')
    else
        args=$(jq -nc --arg l "$layer" '{layer_id: $l, state: "normal", focus: true}')
    fi
    rex api call -s "$sid" session.set_layer_state "$args" >/dev/null
    exit 0
fi

root=$("$HOME/bin/rex-root" "$block" "$sid")
rex api call -s "$sid" session.new_layer "$(jq -nc --arg w "$wid" --arg root "$root" '{
    window_id: $w,
    bounds: [0.03, 0.03, 0.94, 0.94],
    focus: true,
    layout: {block: {
        flavor: "com.superlogical.terminal.shell",
        label: "nvim",
        options: {command: ["nvim"], cwd: $root, interactive: true}
    }}
}')" >/dev/null
