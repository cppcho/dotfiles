#!/usr/bin/env bash
# herdr-open-dir <dir> — focus (or create) the herdr workspace rooted at <dir>,
# worktree-aware. Meant to be called from outside herdr (a VS Code user task
# bound to cmd+ctrl+r, passing ${workspaceFolder}) so an editor window can hand
# its directory back to herdr and land on the matching space. herdr binds the
# same chord to the return trip (~/bin/herdr-code).
#
# When <dir> is the root of a linked git worktree it is opened the way
# `gwt switch` / prefix+shift+g do, so herdr tracks it as a worktree (badge,
# worktree list, clean removal) rather than a generic space. A main checkout, a
# subdirectory, or a plain directory becomes a space at exactly <dir> — spaces
# deliberately rooted at a subdirectory are normal here (see ~/bin/herdr-root).
set -euo pipefail

die() { echo "herdr-open-dir: $1" >&2; exit 1; }

dir="${1:?usage: herdr-open-dir <dir>}"
dir="${dir/#\~/$HOME}"
[[ -d "$dir" ]] || die "no such directory: $dir"
dir=$(cd "$dir" && pwd)
label=$(basename "$dir")

# Focusing a workspace doesn't raise the terminal, so a call from another app
# would otherwise change nothing the caller can see.
activate_terminal() { open -a Ghostty 2>/dev/null || true; }

# The workspace already rooted at $dir, if any.
#
# identity_cwd is where the space was actually opened: the exact answer, and the
# only one that separates two spaces in the same repo or a space rooted at a
# subdirectory of one. It is session state rather than API (see ~/bin/herdr-root),
# so the checkout path herdr tracks per workspace stands in if a release drops
# it. Matching on the directory basename would be wrong at any cost: worktree
# directories are branch slugs, which repeat across repos, so it would happily
# focus another repo's space.
existing_wsid() {
    local sock="${HERDR_SOCKET_PATH:-$HOME/.config/herdr/herdr.sock}" wsid=""

    wsid=$(jq -r --arg p "$dir" '
        first((.workspaces // [])[] | select(.identity_cwd == $p) | .id) // empty' \
        "$(dirname "$sock")/session.json" 2>/dev/null) || true

    if [[ -z "$wsid" ]]; then
        wsid=$(herdr workspace list 2>/dev/null | jq -r --arg p "$dir" '
            first((.result.workspaces // [])[]
                  | select(.worktree.checkout_path == $p) | .workspace_id) // empty') || true
    fi

    printf '%s' "$wsid"
}

if wsid=$(existing_wsid) && [[ -n "$wsid" ]]; then
    herdr workspace focus "$wsid" >/dev/null
    activate_terminal
    exit 0
fi

# Which git checkout, if any, $dir is the root of. A worktree's own root is the
# only path `herdr worktree open` accepts, so comparing against the main
# checkout alone would send every subdirectory of a repo down that branch to
# fail there. No pipe into head: under pipefail a repo with enough worktrees to
# fill the pipe buffer would SIGPIPE git and kill the script.
toplevel="" main_worktree=""
if git -C "$dir" rev-parse --is-inside-work-tree &>/dev/null; then
    toplevel=$(git -C "$dir" rev-parse --show-toplevel)
    main_worktree=$(git -C "$dir" worktree list --porcelain)
    main_worktree=${main_worktree%%$'\n'*}
    main_worktree=${main_worktree#worktree }
fi

if [[ "$toplevel" == "$dir" && -n "$main_worktree" && "$main_worktree" != "$dir" ]]; then
    # --cwd the main checkout: herdr refuses worktree actions whose source is a
    # linked worktree. Idempotent — it reconciles by checkout path, focusing an
    # already-open space and upgrading a plain one to a tracked worktree.
    created=$(herdr worktree open --cwd "$main_worktree" --path "$dir" \
        --label "$label" --focus --json 2>/dev/null) || true
    if [[ -n $(printf '%s' "$created" | jq -r '.result.workspace.workspace_id // empty') ]]; then
        activate_terminal
        exit 0
    fi
fi

herdr workspace create --cwd "$dir" --label "$label" --focus >/dev/null
activate_terminal
