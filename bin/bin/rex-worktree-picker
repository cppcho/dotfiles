#!/usr/bin/env bash
# rex-worktree-picker — pick a worktree of this repo and go to its tab (prefix+g).
#
# Lists the worktrees of the repo the pane is in, most recently opened first
# (rex-recent). `●` marks a worktree that already has a tab in the repo's
# session. Picking one goes to that tab, or opens it (rex-open). To create a
# worktree from a branch or PR, use prefix+shift+g (rex-gwt) instead.
#
# Runs in a floating pane opened by the `float` action in ~/.config/rex/init.lua,
# which starts it in the directory of the pane it was opened from.
#
#   rex-worktree-picker          pick with fzf (rex-fzf)
#   rex-worktree-picker <dir>    open the worktree at <dir>
#   rex-worktree-picker --list   print the ordered rows and exit
set -euo pipefail

# Show a fatal error, then wait so it stays readable before the pane closes.
die() {
    printf '\n\033[1;31mrex-worktree-picker: %s\033[0m\n' "$1" >&2
    printf 'Press Enter to close… ' >&2
    read -r _ || true
    exit 1
}

if [[ $# -eq 1 && $1 != --list ]]; then
    "$HOME/bin/rex-open" "$1" || die "could not open $1"
    exit 0
fi

git rev-parse --show-toplevel >/dev/null 2>&1 || die "not inside a git repository: $PWD"
main=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
repo="${main##*/}"

# Worktrees with a tab in the repo's session, for the `●` marker: a tab whose
# directory rex-open recorded, or else whose label is the worktree's tab label
# (see rex-open).
declare -A has_tab live_tab
tabs_file="${XDG_STATE_HOME:-$HOME/.local/state}/rex/tabs.tsv"
sid=$(rex ls --json | jq -r --arg l "$repo" 'first(.sessions[] | select(.label == $l) | .session_id) // empty')
if [[ -n $sid ]]; then
    while IFS=$'\t' read -r wid label; do
        live_tab[$wid]=1
        has_tab[label:$label]=1
    done < <(rex window ls -s "$sid" --json | jq -r '.windows[]
        | "\(.window_id)\t\(.label)"')
    if [[ -f $tabs_file ]]; then
        while IFS=$'\t' read -r wid dir; do
            [[ -n ${live_tab[$wid]:-} ]] && has_tab[dir:$dir]=1
        done < "$tabs_file"
    fi
fi

declare -A recent
while IFS=$'\t' read -r ts path; do recent[$path]=$ts; done < <("$HOME/bin/rex-recent" list)

# Rows: "<name>\t<branch>\t<worktree path>". The name is the worktree's
# directory, or the repo for the main checkout. The branch is left empty when
# the directory is named after it.
# - Claude Code's own .claude/worktrees checkouts are left out.
# - A detached worktree has no branch line, so it is left out too.
rows=$(
    git worktree list --porcelain | awk -v main="$main" -v repo="$repo" '
        /^worktree / { wt = substr($0, 10) }
        /^branch /   {
            if (wt ~ /\/\.claude\/worktrees\//) next
            b = substr($0, 8); sub(/^refs\/heads\//, "", b)
            n = split(wt, parts, "/"); dir = parts[n]
            if (wt == main) dir = repo
            else if (dir == b) b = ""
            printf "%s\t%s\t%s\n", dir, b, wt
        }'
)
[[ -n $rows ]] || die "no worktree in $repo"

# Sorted rows in rex-fzf's form: "<mark>\t<name>\t<branch>\t<path>".
sorted=$(
    while IFS=$'\t' read -r name branch wt; do
        mark=" "; [[ -n ${has_tab[dir:$wt]:-}${has_tab[label:$name]:-} ]] && mark="●"
        printf '%s\t%s\t%s\t%s\t%s\n' "${recent[$wt]:-0}" "$mark" "$name" "$branch" "$wt"
    done <<<"$rows" | sort -t$'\t' -k1,1rn -k3,3 | cut -f2-
)

if [[ ${1:-} == --list ]]; then
    printf '%s\n' "$sorted" | "$HOME/bin/rex-fzf" rows
    exit 0
fi

exec "$HOME/bin/rex-fzf" pick "$HOME/bin/rex-worktree-picker" \
    --input-label=" $repo worktree " --list-label=' Worktrees ' --header='● open tab' \
    < <(printf '%s\n' "$sorted")
