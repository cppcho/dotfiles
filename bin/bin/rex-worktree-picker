#!/usr/bin/env bash
# rex-worktree-picker — pick a worktree of this repo and go to its tab (prefix+g).
#
# Lists the worktrees of the repo the pane is in, most recently opened first
# (rex-recent). `●` marks a worktree that already has a tab in the repo's
# session. Picking one goes to that tab, or opens it (rex-open). To create a
# worktree from a branch or PR, use prefix+shift+g (rex-gwt) instead.
#
# Runs in a floating pane opened by the `float` action in ~/.config/rex/init.lua,
# which starts it in the directory of the pane it was opened from.
#
#   rex-worktree-picker                 pick with fzf
#   rex-worktree-picker --list          print the ordered rows and exit
#   rex-worktree-picker --move <pane>   move <pane> to the picked worktree's tab
#                                       (prefix+m), and follow it there
set -euo pipefail

move=""
if [[ ${1:-} == --move ]]; then
    move="${2:?usage: rex-worktree-picker --move <pane>}"
fi

# Show a fatal error, then wait so it stays readable before the pane closes.
die() {
    printf '\n\033[1;31mrex-worktree-picker: %s\033[0m\n' "$1" >&2
    printf 'Press Enter to close… ' >&2
    read -r _ || true
    exit 1
}

git rev-parse --show-toplevel >/dev/null 2>&1 || die "not inside a git repository: $PWD"
main=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
repo="${main##*/}"

# Tab labels in the repo's session, for the `●` marker. See rex-open for how
# tabs are labelled.
declare -A has_tab
sid=$(rex ls --json | jq -r --arg l "$repo" 'first(.sessions[] | select(.label == $l) | .session_id) // empty')
if [[ -n $sid ]]; then
    while IFS= read -r label; do
        has_tab[$label]=1
    done < <(rex window ls -s "$sid" --json | jq -r '.windows[].label')
fi

declare -A recent
while IFS=$'\t' read -r ts path; do recent[$path]=$ts; done < <("$HOME/bin/rex-recent" list)

# Rows: "<worktree dir> (<branch>)", or just the one name when the directory is
# named after its branch. The main checkout shows "*<branch>".
# - Claude Code's own .claude/worktrees checkouts are left out.
# - A detached worktree has no branch line, so it is left out too.
rows=$(
    git worktree list --porcelain | awk -v main="$main" '
        /^worktree / { wt = substr($0, 10) }
        /^branch /   {
            if (wt ~ /\/\.claude\/worktrees\//) next
            b = substr($0, 8); sub(/^refs\/heads\//, "", b)
            n = split(wt, parts, "/"); dir = parts[n]
            if (wt == main) shown = "*" b
            else if (dir == b) shown = dir
            else shown = dir " (" b ")"
            printf "%s\t%s\n", shown, wt
        }'
)
[[ -n $rows ]] || die "no worktree in $repo"

listing=$(
    while IFS=$'\t' read -r shown wt; do
        tab="${wt##*/}"; [[ $wt == "$main" ]] && tab="$repo"
        mark=" "; [[ -n ${has_tab[$tab]:-} ]] && mark="●"
        printf '%s\t%s %s\t%s\n' "${recent[$wt]:-0}" "$mark" "$shown" "$wt"
    done <<<"$rows" | sort -t$'\t' -k1,1rn -k2,2 | cut -f2-
)

if [[ ${1:-} == --list ]]; then
    printf '%s\n' "$listing"
    exit 0
fi

selected=$(printf '%s\n' "$listing" \
    | fzf --exact --no-sort --delimiter=$'\t' --with-nth=1 \
          --preview 'echo {2}' --preview-window=down,1 --prompt="$repo worktree > ") || exit 0
[[ -n $selected ]] || exit 0

picked="${selected#*$'\t'}"
if [[ -z $move ]]; then
    "$HOME/bin/rex-open" "$picked" || die "could not open $picked"
    exit 0
fi

# Move the pane beside the first pane of the picked tab. A tab this call
# created holds only a fresh shell, which is closed so the moved pane is left
# alone in it.
opened=$("$HOME/bin/rex-open" --print "$picked") || die "could not open $picked"
IFS=$'\t' read -r sid _ new first <<<"$opened"
[[ $first != "$move" ]] || exit 0
rex move -s "$sid" "$move" right "$first" >/dev/null || die "could not move the pane"
if [[ $new == 1 ]]; then
    rex block close -s "$sid" "$first" >/dev/null
fi
