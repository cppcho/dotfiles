#!/usr/bin/env bash
# herdr-worktree-picker — switch to another worktree of the repo you are in.
# Bound to prefix+g, the herdr port of tmux's `bind g … gwt switch`.
#
# The picker mirrors herdr-sessionizer (prefix+f): same row shape, `●` on
# worktrees that already have a live space, most recently opened first. Where
# prefix+f spans every repo and worktree, this one is scoped to the current
# repo — and prefix+shift+g is the prompt that creates one from a branch or PR.
#
# Bind via a herdr [[keys.command]] with type = "pane" so fzf gets a tty and
# the pane inherits the caller's cwd, which is the repo whose worktrees this
# lists (terminal.new_cwd defaults to "follow"):
#   [[keys.command]]
#   key = "prefix+g"
#   type = "pane"
#   command = "~/bin/herdr-worktree-picker"
#
# With --list it prints the ordered rows and exits (for debugging).
set -euo pipefail

# Surface a fatal error in the throwaway herdr pane, then pause so it stays
# readable before the pane closes.
die() {
    printf '\n\033[1;31mherdr-worktree-picker: %s\033[0m\n' "$1" >&2
    printf 'Press Enter to close… ' >&2
    read -r _ || true
    exit 1
}

git rev-parse --show-toplevel >/dev/null 2>&1 || die "not inside a git repository"
main=$(git worktree list --porcelain | sed -n '1s/^worktree //p')

# Rows are "<repo>\t<worktree dir> (<branch>)\t<path>", the same shape prefix+f
# prints: the main checkout has no directory of its own to name, so it shows
# "*<branch>", and a directory named after its branch shows just the one name.
# Claude Code's own .claude/worktrees checkouts are dropped as prefix+f drops
# them, and a detached worktree has no branch line so it drops out with it.
rows=$(
    git worktree list --porcelain | awk -v main="$main" -v repo="${main##*/}" '
        /^worktree / { wt = substr($0, 10) }
        /^branch /   {
            if (wt ~ /\/\.claude\/worktrees\//) next
            b = substr($0, 8); sub(/^refs\/heads\//, "", b)
            n = split(wt, parts, "/"); dir = (wt == main ? "" : parts[n])
            rest = (dir == "" ? "*" b : (dir == b ? dir : dir " (" b ")"))
            printf "%s\t%s\t%s\n", repo, rest, wt
        }'
)
[[ -n $rows ]] || die "no worktree in ${main##*/}"

# Open workspaces, by checkout path and by label, for the `●` marker on rows
# whose pick joins a live space instead of opening one. Spaces opened before
# herdr indexed their worktree only carry a label.
declare -A path_ws lbl_ws
while IFS=$'\t' read -r wsid label cpath; do
    [[ -n $cpath ]] && path_ws[$cpath]=$wsid
    [[ -n $label ]] && lbl_ws[$label]=$wsid
done < <(herdr workspace list 2>/dev/null | jq -r '(.result.workspaces // [])[]
    | "\(.workspace_id)\t\(.label)\t\(.worktree.checkout_path // "")"')

declare -A recent
while IFS=$'\t' read -r ts rp; do recent[$rp]=$ts; done < <("$HOME/bin/herdr-recent" list)

listing=$(
    while IFS=$'\t' read -r repo rest wt; do
        mark=" "; [[ -n ${path_ws[$wt]:-} || -n ${lbl_ws[${wt##*/}]:-} ]] && mark="●"
        printf '%s\t%s %s\t%s\n' "${recent[$wt]:-0}" "$mark" "$(printf '%-24s %s' "$repo" "$rest")" "$wt"
    done <<<"$rows" | sort -t$'\t' -k1,1rn -k2,2 | cut -f2-
)

if [[ ${1:-} == --list ]]; then
    printf '%s\n' "$listing"
    exit 0
fi

selected=$(printf '%s\n' "$listing" \
    | fzf --exact --no-sort --delimiter=$'\t' --with-nth=1 \
          --preview 'echo {2}' --preview-window=down,1 --prompt='Worktree > ') || exit 0
[[ -z $selected ]] && exit 0

"$HOME/bin/herdr-workspace-for" --focus "${selected#*$'\t'}" >/dev/null \
    || die "could not open a space for ${selected#*$'\t'}"
