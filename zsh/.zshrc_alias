alias vim='nvim'
alias vi='nvim'

alias ta='~/bin/tmux-sessionizer ~/dotfiles'
alias af='~/bin/tmux-sessionizer'
alias ts='~/bin/tmux-session-picker'
alias update='brew update; brew upgrade -y; brew cleanup'
alias ghs='gh stack'
alias k=kubectl
alias ag='rg'
alias c='_ ; claude'
alias r='claude --resume'
alias t='claude --continue'
alias h='herdr'
alias gclone='~/bin/git-clone-dev'

# Go home: cd to the top of the current project — the tmux session's start dir,
# or under herdr the space's own directory (~/bin/herdr-root, which falls back to
# the git root for a plain shell) — and put a gwt worktree back on its branch.
#
# oh-my-zsh's lib/misc.zsh binds `_` to `sudo `, and an alias shadows a function
# of the same name — worse, it makes the definition below a parse error. Drop it
# first; it must be its own command so the alias is gone before zsh parses the
# function.
unalias _ 2>/dev/null
_() {
  local dir
  if [[ -n "$TMUX" ]]; then
    dir=$(tmux display-message -p "#{session_path}")
  else
    dir=$(herdr-root) || return
  fi
  cd "$dir" || return
  # A `git checkout` inside a gwt worktree leaves it holding someone else's
  # branch; going home resets that too. No-op outside a gwt tree — but gwt
  # itself refuses to run outside a repo, so don't call it in a plain directory.
  if git rev-parse --git-dir &>/dev/null; then
    command gwt reclaim
  fi
}

# ~/bin/gwt runs as a child process, so its `cd` can't move this shell. It
# writes the target dir to $GWT_CD_FILE; cd there after it exits, so `gwt
# delete`/`purge` from inside the removed worktree lands you in the main repo
# (previously only worked inside tmux via a send-keys hack).
gwt() {
  local cdfile ret dest
  cdfile=$(mktemp "${TMPDIR:-/tmp}/gwt-cd.XXXXXX") || { command gwt "$@"; return; }
  GWT_CD_FILE="$cdfile" command gwt "$@"
  ret=$?
  if [[ -s "$cdfile" ]]; then
    dest=$(<"$cdfile")
    [[ -d "$dest" ]] && cd "$dest"
  fi
  rm -f "$cdfile"
  return $ret
}

# Jump straight to the Claude-session picker (same popup as tmux prefix v),
# whether or not you're already inside tmux.
vv() {
  if [[ -n "$TMUX" ]]; then
    tmux display-popup -E -w 64% -h 64% "$HOME/bin/tmux-claude-sessions"
  else
    # A popup needs an attached client, so register a one-shot client-attached
    # hook (self-removing) and then attach — creating a session if none exists.
    tmux has-session 2>/dev/null || tmux new-session -d
    tmux set-hook -g client-attached \
      'display-popup -E -w 64% -h 64% "~/bin/tmux-claude-sessions" ; set-hook -gu client-attached' \; \
      attach
  fi
}

# Fuzzy-pick a directory from z's frecency list and cd into it.
zz() {
  local dir
  dir=$(z -l 2>&1 | sed "s/^[0-9.,]* *//; s|^$HOME|~|" | fzf --tac --no-sort --query "$*") && cd "${dir/#\~/$HOME}"
}

# Copy the current Claude session id to the clipboard (no trailing newline, so
# it pastes into `claude --resume` cleanly).
csid() {
  local id
  id=$(claude-session-id) || return
  printf '%s' "$id" | pbcopy
  echo "$id  (copied)"
}

# URL encode a string
urlencode() { python3 -c "import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=''))" "$1"; }
